APP_NAME=Sentix API
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/sentix
AUTH_PROVIDER=supabase
STORAGE_PROVIDER=supabase
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_REVIEWS=100000
SENTIMENT_PREDICTOR_PROVIDER=dummy
SENTIMENT_BATCH_SIZE=256
JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_TOKEN_EXPIRE_MINUTES=60
REQUIRE_EMAIL_VERIFICATION=false
ALLOW_DEV_AUTH_FALLBACK=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SENTIX
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_STORE_NAME=Sentix Demo Store
DEV_USER_EMAIL=demo@sentix.local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=uploads
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_PUBLIC_URL=http://localhost:3000
